DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
CORS_ALLOWED_ORIGINS=http://localhost:5173
OTP_SMS_BACKEND=console
OTP_CONSENT_VERSION=mysobo-consent-v1
# Production: use OTP_SMS_BACKEND=twilio and configure these credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sign in with Google: OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Preview only: sign in with any email, no verification. Set false before launch.
DEMO_EMAIL_LOGIN=false

# Database resilience (see README: Production database)
DB_CONN_MAX_AGE=60
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
DB_TRANSACTION_POOLER=false
