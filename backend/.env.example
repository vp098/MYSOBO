DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Optional for local disk storage; required in production for persistent media.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
OTP_SMS_BACKEND=console
OTP_CONSENT_VERSION=mysobo-consent-v1
# Production: use OTP_SMS_BACKEND=twilio and configure these credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
