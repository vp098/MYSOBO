# API calls always go to same-origin /api (Vite proxy locally, Vercel rewrite in production).
# Sign in with Google: same OAuth Web client ID as the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
# Set to true to show SMS one-time-code sign-in again (needs DLT-approved SMS)
VITE_ENABLE_SMS_OTP=false
# Preview only: sign in with any email, no verification. Set false before launch.
VITE_DEMO_LOGIN=false
